{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bung-bunty-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "BungRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BungRoom"] }],
  "vars": { "ALLOWED_ORIGINS": "https://danielslater3.github.io,http://localhost:8765,http://127.0.0.1:8765" },
  "observability": { "enabled": true, "head_sampling_rate": 0.05 }
}
